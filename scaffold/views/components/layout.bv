(defn layout [page {:site Site :style Metadata :search Search}
              page-title String description String og-type String
              header-content Flow main-content Flow]
  (document page page-title (seo page page-title description og-type) header-content main-content))

(defn- seo [page {:site Site :search Search} page-title String description String og-type String]
  [(meta {:name "description" :content description})
   (link {:rel "canonical" :href page.search.url})
   (meta {:property "og:title" :content page-title})
   (meta {:property "og:description" :content description})
   (meta {:property "og:type" :content og-type})
   (meta {:property "og:url" :content page.search.url})
   (meta {:property "og:site_name" :content page.site.title})
   (meta {:property "og:image" :content page.site.og-image})
   (meta {:property "og:image:alt" :content page.site.title})
   page.search.json-ld])
