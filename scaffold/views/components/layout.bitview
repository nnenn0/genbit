fn layout(ctx, page-title, description, og-type, header-content, main-content) =>
  document(ctx, page-title, seo(ctx, page-title, description, og-type), header-content, main-content)

fn seo(ctx, page-title, description, og-type) => [
  meta({name: "description", content: description}),
  link({rel: "canonical", href: ctx.canonical-url}),
  meta({property: "og:title", content: page-title}),
  meta({property: "og:description", content: description}),
  meta({property: "og:type", content: og-type}),
  meta({property: "og:url", content: ctx.canonical-url}),
  meta({property: "og:site_name", content: ctx.site.title}),
  meta({property: "og:image", content: ctx.site.og-image}),
  meta({property: "og:image:alt", content: ctx.site.title}),
  ctx.json-ld,
]
