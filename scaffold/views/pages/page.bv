fn page(ctx) =>
  layout(ctx, concat(ctx.article.title, " | ", ctx.site.title), ctx.article.description, "article",
    home-link(ctx),
    article(
      h1(ctx.article.title, draft-badge(ctx.article)),
      dl({class: "article-meta"},
        dt("created_at"), dd(timestamp(ctx.article.created-at)),
        dt("updated_at"), dd(timestamp(ctx.article.updated-at)),
        dt("tags"), dd(map(ctx.article.tags, tag-link))
      ),
      ctx.content
    )
  )

fn tag-link(tag) => a({href: tag.url}, tag.name)
